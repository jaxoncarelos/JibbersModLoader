// Hardware ray-traced sun shadows and ambient occlusion for Jibbers (built-in pipeline, DX12 DXR).
// Rays only ask "is anything in the way?": the miss shader marks a clear path and closest-hit shaders
// are skipped, so the game's own materials need no ray-tracing passes. Each pixel's world position
// comes from the depth buffer.
#pragma max_recursion_depth 1

RaytracingAccelerationStructure _RT_Scene;
Texture2D<float> _CameraDepthTexture;
SamplerState sampler_point_clamp;
RWTexture2D<float2> _RT_Out;   // x sun occlusion of lit surfaces, y ambient occlusion

float4x4 _RT_InvViewProj;  // inverse of (GPU projection without Y flip) * view
float4 _RT_CameraPos;      // xyz camera position
float4 _RT_SunDir;         // xyz direction towards the sun, w sun cone half-angle (radians)
float4 _RT_Params;         // x AO radius (m), y frame index, z shadow ray length (m), w AO ray count
float4 _RT_Size;           // x,y trace size; z,w full-resolution size
float4 _RT_Debug;          // x: 0 normal, 1 depth view, 2 camera-ray hit test

struct Payload { float hit; };

[shader("miss")]
void Miss(inout Payload payload : SV_RayPayload) { payload.hit = 0; }

float3 WorldFromUV(float2 uv, float rawDepth)
{
    float4 world = mul(_RT_InvViewProj, float4(uv * 2 - 1, rawDepth, 1));
    return world.xyz / world.w;
}
float RawDepth(float2 uv) { return _CameraDepthTexture.SampleLevel(sampler_point_clamp, uv, 0); }
uint Hash(uint x) { x ^= x >> 16; x *= 0x7feb352d; x ^= x >> 15; x *= 0x846ca68b; return x ^ (x >> 16); }
float Random(inout uint state) { state = Hash(state); return (state & 0xffffff) / 16777216.0; }
void Basis(float3 n, out float3 t, out float3 b)
{
    float3 up = abs(n.y) < 0.99 ? float3(0, 1, 0) : float3(1, 0, 0);
    t = normalize(cross(up, n)); b = cross(n, t);
}
float Occluded(float3 origin, float3 direction, float length)
{
    RayDesc ray; ray.Origin = origin; ray.Direction = direction; ray.TMin = 0.0; ray.TMax = length;
    Payload payload; payload.hit = 1;
    TraceRay(_RT_Scene, RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER | RAY_FLAG_FORCE_OPAQUE,
             0xFF, 0, 1, 0, ray, payload);
    return payload.hit;
}

[shader("raygeneration")]
void Trace()
{
    uint2 id = DispatchRaysIndex().xy;
    // Sample an exact full-resolution texel so the neighbours below are distinct depth samples.
    float2 scale = _RT_Size.zw / _RT_Size.xy;
    float2 uv = (floor(id * scale) + 0.5) / _RT_Size.zw;
    float raw = RawDepth(uv);
    if (_RT_Debug.x == 1) { _RT_Out[id] = float2(saturate(raw * 20), 0); return; }
    if (_RT_Debug.x == 2)
    {
        float3 target = WorldFromUV(uv, raw);
        float3 dir = normalize(target - _RT_CameraPos.xyz);
        _RT_Out[id] = float2(Occluded(_RT_CameraPos.xyz, dir, 1000), saturate(length(target - _RT_CameraPos.xyz) / 60));
        return;
    }
#if UNITY_REVERSED_Z
    if (raw <= 0.0) { _RT_Out[id] = 0; return; }
#else
    if (raw >= 1.0) { _RT_Out[id] = 0; return; }
#endif
    float3 p = WorldFromUV(uv, raw);
    float2 px = 1.0 / _RT_Size.zw;
    float3 pr = WorldFromUV(uv + float2(px.x, 0), RawDepth(uv + float2(px.x, 0)));
    float3 pl = WorldFromUV(uv - float2(px.x, 0), RawDepth(uv - float2(px.x, 0)));
    float3 pu = WorldFromUV(uv + float2(0, px.y), RawDepth(uv + float2(0, px.y)));
    float3 pd = WorldFromUV(uv - float2(0, px.y), RawDepth(uv - float2(0, px.y)));
    float3 dx = distance(pr, p) < distance(pl, p) ? pr - p : p - pl;
    float3 dy = distance(pu, p) < distance(pd, p) ? pu - p : p - pd;
    float3 toCamera = _RT_CameraPos.xyz - p;
    float3 c = cross(dy, dx);
    float3 n = dot(c, c) > 1e-12 ? normalize(c) : normalize(toCamera);
    if (dot(n, toCamera) < 0) n = -n;
    float distanceToCamera = length(toCamera);
    float3 origin = p + n * (0.03 + distanceToCamera * 0.0015);
    uint seed = Hash(id.x * 1973u + id.y * 9277u + (uint)_RT_Params.y * 26699u);

    // Sun: four rays inside the sun's cone give soft penumbrae that harden near contact.
    float3 sun = normalize(_RT_SunDir.xyz);
    float facing = saturate(dot(n, sun));
    float shadow = 0;
    if (facing > 0.0)
    {
        float3 st, sb; Basis(sun, st, sb);
        [unroll] for (int i = 0; i < 4; i++)
        {
            float r = sqrt(Random(seed)) * _RT_SunDir.w, a = Random(seed) * 6.2831853;
            shadow += 0.25 * Occluded(origin, normalize(sun + (st * cos(a) + sb * sin(a)) * r), _RT_Params.z);
        }
        shadow *= smoothstep(0.0, 0.15, facing);
    }

    // Ambient occlusion: cosine-weighted rays; alternate rays test a short and a long radius.
    float3 t, b; Basis(n, t, b);
    float ao = 0;
    int count = (int)_RT_Params.w;
    float radius = _RT_Params.x * (1.0 + distanceToCamera * 0.01);
    for (int j = 0; j < count; j++)
    {
        float u1 = Random(seed), u2 = Random(seed);
        float r = sqrt(u1), a = u2 * 6.2831853;
        float3 d = normalize(t * (r * cos(a)) + b * (r * sin(a)) + n * sqrt(1 - u1));
        ao += Occluded(origin, d, (j & 1) ? radius : radius * 0.35);
    }
    ao = count > 0 ? ao / count : 0;
    _RT_Out[id] = float2(shadow, ao);
}
